# libFuzzer dictionary for the hset file format: chunk tags, hash-header
# prefixes, hint-kind/bits pairs, the format version and a zero length.
magic="SetOHash"
ftoc="FTOC"
fhdr="FHDR"
rhdr="RHDR"
rdat="RDAT"
hdat="HDAT"
hint="HINT"
ridx="RIDX"
fltr="FLTR"
fend="FEND"
hh_md5="HH\x00\x00"
hh_sha1="HH\x00\x01"
hh_sha256="HH\x00\x03"
hh_size="HH\x00\x0d"
hull8="h\x08"
hull0="h\x00"
block8="b\x08"
block1="b\x01"
version2="\x02\x00\x00\x00\x00\x00\x00\x00"
len0="\x00\x00\x00\x00\x00\x00\x00\x00"
# TLSH: the hash header (type 2^15), the 0x7400 cell-index hint, the TIVF
# index and the rejected TVEC chunk, the TIVF header's version, flags and
# dims, and the digest's hex prefixes.
hh_tlsh="HH\x00\x0f"
tivf="TIVF"
tvec="TVEC"
hint_tlsh="t\x00"
tivf_head="\x03\x00\x00\x00\x00\x01\x00\x00"
tlsh_t1="T1"
tlsh_null="TNULL"
